# Đường chạy mặc định trên Windows dùng kho JSON.
# DATA_DIR=.data
# Tùy chọn Supabase: URL ứng dụng dùng để xác nhận email đăng ký.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ điền trong môi trường máy chủ. Để trống cả ba biến Supabase để chạy với kho JSON.
SUPABASE_SECRET_KEY=
# Dùng giá trị ngẫu nhiên dài ít nhất 32 byte khi kết nối Supabase.
RATE_LIMIT_HMAC_SECRET=
CHECKOUT_RATE_LIMIT_MAX=5
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=600
ORDER_LOOKUP_RATE_LIMIT_MAX=15
ORDER_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=600
